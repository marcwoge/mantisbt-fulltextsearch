# Local Docker sandbox only. Copy to .env and choose your own values:
#   cp .env.example .env
# .env is git-ignored. Generate values e.g. with: openssl rand -hex 32
MARIADB_ROOT_PASSWORD=change-me-root
MANTIS_DB_PASSWORD=change-me-mantis
# >= 16 characters
MANTIS_CRYPTO_MASTER_SALT=change-me-to-a-random-string-of-at-least-32-chars
